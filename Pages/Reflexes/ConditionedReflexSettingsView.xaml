<Window x:Class="AIStudio.Views.ConditionedReflexSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIStudio.Views"
        xmlns:converters="clr-namespace:AIStudio.Converters"
        mc:Ignorable="d"
        Title="Настройки условных рефлексов" 
        Height="Auto" Width="1180" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF0F0F0">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SettingsRangeTextStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Foreground" Value="#FF666666"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontStyle" Value="Italic"/>
      <Setter Property="Width" Value="120"/>
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Width" Value="80"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="IsTabStop" Value="True"/>
      <Setter Property="TabIndex" Value="0"/>
    </Style>

    <Style x:Key="SettingsButtonStyle" TargetType="Button">
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GridRowStyle" TargetType="Grid">
      <Setter Property="Margin" Value="0,8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,2"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#FF1565C0"/>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
  </Window.InputBindings>

  <Border Margin="2" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
    <Grid Margin="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Заголовок -->
      <Border Grid.Row="0" Background="#FFE8E8E8" CornerRadius="3" Padding="5,8">
        <StackPanel>
          <TextBlock Text="Настройки условных рефлексов" 
                     FontSize="16" FontWeight="Bold" 
                     Foreground="#FF333333"/>
          <TextBlock Text="Параметры математической модели условных рефлексов" 
                     FontSize="12" FontStyle="Italic" 
                     Foreground="#FF666666" Margin="0,2,0,0"/>

          <!-- Индикатор несохраненных изменений -->
          <TextBlock Text="Есть несохраненные изменения" 
                     FontSize="11" FontWeight="Bold"
                     Foreground="#FFD32F2F" 
                     Margin="0,4,0,0"
                     Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
      </Border>

      <!-- Таблица настроек: два столбца, чтобы уменьшить высоту формы -->
      <Border Grid.Row="1" Margin="0,2,0,0" 
              BorderBrush="#FFDDDDDD" BorderThickness="1" 
              CornerRadius="3" Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
          <Grid Margin="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Вертикальный разделитель между столбцами -->
            <Rectangle Grid.Column="1" Width="1" Margin="10,0"
                       Fill="#FFDDDDDD" HorizontalAlignment="Center"/>

            <!-- ============ ЛЕВЫЙ СТОЛБЕЦ ============ -->
            <StackPanel Grid.Column="0">

              <!-- ===== Основные параметры ===== -->
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2"
                         Text="Основные параметры"/>

              <!-- Коэффициент обучения -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Коэффициент обучения (α):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.LearningRate, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.1 - 0.3)"/>
              </Grid>

              <!-- Коэффициент затухания сенсорных ассоциаций -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Коэфф. затухания λ (сенсорные CS↔CS):"
                           ToolTip="Коэффициент затухания λ для сенсорных ассоциаций CS↔CS;passed через InitialLifetimePulses (динамический TTL)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.DecayRate, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.95 - 0.99)"/>
              </Grid>

              <!-- Порог активации -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Порог активации (γ):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.ActivationThreshold, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.5 - 0.7)"/>
              </Grid>

              <!-- Начальный лимит простоя УР -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Начальный лимит простоя (пульсы):"
                           ToolTip="При создании УР: ExpiresAt = now + T0; при каждой активации T0 удваивается"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.InitialLifetimePulses, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(3600 - 604800)"/>
              </Grid>

              <!-- Активное угасание -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Активное угасание (α_ext):"
                           ToolTip="Шаг RW при CS без US в окне τ; действует и на сильные УР"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.ActiveExtinctionRate, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.01 - 0.2)"/>
              </Grid>

              <!-- Временное окно корреляции -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Временное окно корреляции (τ):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         Text="{Binding Settings.TimeWindowPulses, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(1 - 10 пульсов)"/>
              </Grid>

              <!-- Минимальная крепость связи -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Минимальная крепость связи (C_min):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.MinAssociationStrength, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.01 - 0.3)"/>
              </Grid>

              <!-- Коэффициент понижения крепости вторичных -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Коэфф. понижения крепости вторичных (K):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.HigherOrderStrengthReductionCoefficient, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                         ToolTip="Для третичных автоматически удваивается"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(1.2 - 3.0)"/>
              </Grid>

              <!-- Порог θ_comp для смешанного ответа / конкуренции -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Порог отношения крепостей (θ_comp):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.CompetitionStrengthRatioThreshold, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.5 - 0.9)"/>
              </Grid>

              <!-- Ничья по крепости: меньший или больший ID -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="При равной крепости кандидатов:"/>
                <CheckBox Grid.Column="1"
                          Content="предпочитать меньший ID у-рефлекса"
                          IsChecked="{Binding Settings.TieBreakPreferSmallerReflexId, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"
                          ToolTip="Если снять флажок — при равной крепости выбирается больший ID"/>
              </Grid>

              <!-- Максимальная крепость связи -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Максимальная крепость связи (β):"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         Text="{Binding Settings.MaxAssociationStrength, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                         IsReadOnly="True" Background="#FFF5F5F5"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(фиксировано)"/>
              </Grid>

              <!-- ===== Угасание ===== -->
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Угасание"/>

              <!-- Период пассивного угасания -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Период пассивного угасания (пульсы):"
                           ToolTip="Раз в PassiveDecayPeriodPulses пульсов крепость УР снижается. Значение &lt;=0 включает резервный период"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.PassiveDecayPeriodPulses, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0 - 86400)"/>
              </Grid>

              <!-- Резервный период пассивного угасания -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Резервный период угасания (пульсы):"
                           ToolTip="Используется, если PassiveDecayPeriodPulses задан неверно (0 или меньше)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.PassiveDecayFallbackPeriodPulses, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(1 - 86400)"/>
              </Grid>

            </StackPanel>

            <!-- ============ ПРАВЫЙ СТОЛБЕЦ ============ -->
            <StackPanel Grid.Column="2">

              <!-- ===== Конкурентное обучение ===== -->
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2"
                         Text="Конкурентное обучение"/>

              <!-- Включить конкурентный слой обучения -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Конкурентный слой обучения (Rescorla–Wagner):"/>
                <CheckBox Grid.Column="1"
                          Content="включить (Kamin blocking / ΔV)"
                          IsChecked="{Binding Settings.EnableCompetitiveLearning, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"
                          ToolTip="При включении α при CS→US распределяется с учётом предсказуемости US другими CS. Иначе каждый CS обучается независимо (модель без ΔV)"/>
              </Grid>

              <!-- Коэффициент подавления конкурирующими CS -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Доля подавления конкурентами:"
                           ToolTip="0 — блокировки нет; 1 — подавляющий конкурент гасит подкрепление целиком. Действует при включённом конкурентном слое"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.CompetitionSuppressionCoefficient, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- ===== Начальная крепость и установление ===== -->
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Начальная крепость и установление"/>

              <!-- Прибавка к стартовой крепости -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Прибавка к стартовой крепости:"
                           ToolTip="C₀ = (C_min + InitialStrengthBonus) / K(order)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.InitialStrengthBonus, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- Крепость авторитарной записи -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Крепость авторитарной записи:"
                           ToolTip="Крепость при ручной записи оператора, до понижения по порядку: C₀ = AuthoritativeStrength / K(order)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.AuthoritativeStrength, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- Порог установившегося рефлекса -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Порог «установившегося» рефлекса:"
                           ToolTip="MaxAchievedStrength выше этого значения ⇒ рефлекс считается установившимся (IsEstablished)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.EstablishedStrengthThreshold, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- Доля α при успешной активации -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Доля α при подкреплении активацией:"
                           ToolTip="α_rein = LearningRate · ActivationReinforcementFraction / K(order)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.ActivationReinforcementFraction, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- Потолок удвоения TTL -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Потолок TTL при удвоении (пульсы):"
                           ToolTip="Ограничение удвоения LifetimePulses при активации/успехе"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.MaxLifetimePulsesCap, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(≥ InitialLifetimePulses)"/>
              </Grid>

              <!-- ===== Сенсорные ассоциации CS↔CS ===== -->
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Сенсорные ассоциации CS↔CS"/>

              <!-- Период затухания сенсорных связей -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Период затухания CS↔CS (пульсы):"
                           ToolTip="Период затухания сенсорных связей CS↔CS в пульсах (ApplyDecay срабатывает на кратных)"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.SensoryDecayPeriodPulses, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(1 - 86400)"/>
              </Grid>

              <!-- Нижний предел крепости CS↔CS -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Нижний предел крепости CS↔CS:"
                           ToolTip="Нижний порог эффективной крепости для расчёта кривой затухания CS↔CS"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.SensoryStrengthFloor, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- Верхняя зона CS↔CS -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Верхняя зона крепости CS↔CS:"
                           ToolTip="Выше порога связь считается устойчивой и точится по SensoryHighStrengthDecayRate независимо от γ"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.SensoryHighStrengthThreshold, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

              <!-- Коэфф. затухания устойчивых CS↔CS -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Эфф. коэфф. затухания устойчивых CS↔CS:"
                           ToolTip="Эффективный коэффициент затухания для устойчивых (высоких) связей CS↔CS"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.SensoryHighStrengthDecayRate, UpdateSourceTrigger=LostFocus, StringFormat=N3, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.9 - 1.0)"/>
              </Grid>

              <!-- Средняя зона CS↔CS -->
              <Grid Style="{StaticResource GridRowStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabelStyle}"
                           Text="Средняя зона крепости CS↔CS:"
                           ToolTip="От этого порога до верхней — затухание по γ^C, ниже — по γ^√C"/>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBoxStyle}"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                         LostFocus="TextBox_LostFocus"
                         Text="{Binding Settings.SensoryMidStrengthThreshold, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SettingsRangeTextStyle}"
                           Text="(0.0 - 1.0)"/>
              </Grid>

            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>

      <!-- Кнопки -->
      <Border Grid.Row="2" Margin="0,10,0,0" Background="#FFE8E8E8" 
              CornerRadius="3" Padding="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Применить -->
          <Button Grid.Column="1" Content="Применить" 
                  Command="{Binding ApplyCommand}"
                  Style="{StaticResource SettingsButtonStyle}"
                  Background="#FF4CAF50" Foreground="White">
            <Button.ToolTip>
              <TextBlock Text="Применить изменения без сохранения в файл" 
                         FontSize="11" TextWrapping="Wrap"/>
            </Button.ToolTip>
          </Button>

          <!-- Сохранить -->
          <Button Grid.Column="2" Content="Сохранить" 
                  Command="{Binding SaveCommand}"
                  Style="{StaticResource SettingsButtonStyle}"
                  Background="#FF2196F3" Foreground="White">
            <Button.ToolTip>
              <TextBlock Text="Сохранить изменения в файл и закрыть окно" 
                         FontSize="11" TextWrapping="Wrap"/>
            </Button.ToolTip>
          </Button>

          <!-- Отмена -->
          <Button Grid.Column="3" Content="Отмена" 
                  Command="{Binding CancelCommand}"
                  Style="{StaticResource SettingsButtonStyle}"
                  Background="#FFF44336" Foreground="White">
            <Button.ToolTip>
              <TextBlock Text="Закрыть окно без сохранения" 
                         FontSize="11" TextWrapping="Wrap"/>
            </Button.ToolTip>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>