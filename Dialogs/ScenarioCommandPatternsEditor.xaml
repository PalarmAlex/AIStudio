<Window x:Class="AIStudio.Dialogs.ScenarioCommandPatternsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Команды Command-канала" Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="560"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FF2196F3" CornerRadius="4" Margin="0,0,0,10" Padding="10">
      <TextBlock x:Name="HeaderTitle" Text="Команды Command-канала"
                 FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
    </Border>

    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FilterTextBox" Grid.Column="0" Padding="4,3" FontSize="12"
               TextChanged="FilterTextBox_TextChanged"
               ToolTip="Фильтр по ID или тексту паттерна"/>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                 FontSize="11" Foreground="#FF616161"
                 Text="Порядок важен для genetic match"/>
    </Grid>

    <Border Grid.Row="2" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#FFE8EAF6" BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,1,1" Padding="8,6">
          <TextBlock Text="ДОСТУПНЫЕ" FontWeight="Bold" FontSize="13" Foreground="#FF3F51B5"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Background="#FFE8EAF6" BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,1,1" Padding="8,6">
          <TextBlock Text=" " FontSize="13"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Background="#FFE8EAF6" BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,0,1" Padding="8,6">
          <TextBlock Text="ВЫБРАННЫЕ (ПОРЯДОК)" FontWeight="Bold" FontSize="13" Foreground="#FF3F51B5"/>
        </Border>

        <ListBox Grid.Row="1" Grid.Column="0" x:Name="AvailableList"
                 DisplayMemberPath="DisplayText"
                 MouseDoubleClick="AvailableList_MouseDoubleClick"
                 Background="#FFF9F9F9" BorderThickness="0"/>

        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
          <Button Content="&gt;&gt;" Width="40" Height="28" Margin="0,4" Click="AddButton_Click"
                  FontSize="13" FontWeight="Bold" Cursor="Hand"/>
          <Button Content="&lt;&lt;" Width="40" Height="28" Margin="0,4" Click="RemoveButton_Click"
                  FontSize="13" FontWeight="Bold" Cursor="Hand"/>
          <Button Content="&#x25B2;" Width="40" Height="28" Margin="0,12,0,4" Click="MoveUpButton_Click"
                  FontSize="13" Cursor="Hand"/>
          <Button Content="&#x25BC;" Width="40" Height="28" Margin="0,4" Click="MoveDownButton_Click"
                  FontSize="13" Cursor="Hand"/>
        </StackPanel>

        <ListBox Grid.Row="1" Grid.Column="2" x:Name="SelectedList"
                 DisplayMemberPath="DisplayText"
                 MouseDoubleClick="SelectedList_MouseDoubleClick"
                 Background="#FFF9F9F9" BorderThickness="0"/>
      </Grid>
    </Border>

    <Border Grid.Row="3" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4"
            Padding="10" Margin="0,12,0,0" Background="#FFF5F5F5">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="OK" Width="100" Height="32" Margin="0,0,8,0"
                IsDefault="True" Click="OK_Click"
                Background="#FF4CAF50" BorderBrush="#FF388E3C" Foreground="White" FontWeight="SemiBold"/>
        <Button Content="Отмена" Width="100" Height="32" Click="Cancel_Click"
                Background="#FFF5F5F5" BorderBrush="#FF9E9E9E"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>